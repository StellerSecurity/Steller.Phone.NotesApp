{
  "name": "Steller.Phone.NotesApp",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "node scripts/verify-identity-runtime.cjs && node scripts/harden-dependencies.cjs && ng",
    "start": "node scripts/verify-identity-runtime.cjs && node scripts/harden-dependencies.cjs && ng serve",
    "build": "node scripts/verify-identity-runtime.cjs && node scripts/harden-dependencies.cjs && ng build",
    "watch": "node scripts/verify-identity-runtime.cjs && node scripts/harden-dependencies.cjs && ng build --watch --configuration development",
    "test": "node scripts/harden-dependencies.cjs && ng test",
    "lint": "node scripts/harden-dependencies.cjs && node scripts/verify-identity-runtime.cjs && ng lint",
    "capacitor:copy:after": "node scripts/configure-background-sync.mjs",
    "capacitor:sync:after": "node scripts/configure-background-sync.mjs",
    "capacitor:update:after": "node scripts/configure-background-sync.mjs",
    "test:sync": "node scripts/harden-dependencies.cjs && ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.sync-spec.json --include=src/runtime/notes-design-runtime.spec.ts --include=src/runtime/local-account-profiles.spec.ts --include=src/app/services/sync-worker-retention.spec.ts --include=src/app/services/notes-api-v1.service.spec.ts --include=src/app/profile/profile-sync.spec.ts --include=src/app/add-note/rich-text-editor/preserve-note-line-breaks.spec.ts --include=src/app/home/home-sync.spec.ts --include=src/app/utils/folder-reference.spec.ts --include=src/app/services/notes-storage-retention.spec.ts --include=src/app/services/upload-confirmation.spec.ts --include=src/app/add-note/save-durability.spec.ts --include=src/app/profile/download-isolation.spec.ts --include=src/app/controlled-flow-audit.spec.ts --include=src/app/utils/note-search.spec.ts --include=src/app/adversarial-sync.spec.ts --include=src/app/editor-stress.spec.ts --include=src/app/focus-audit.spec.ts --include=src/app/html-security-audit.spec.ts --include=src/app/add-note/rich-text-editor/editor-scroll.spec.ts --include=src/app/services/identity-auth.spec.ts --include=src/app/services/realtime-notes.service.spec.ts",
    "test:security": "node scripts/harden-dependencies.cjs && ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.security-audit.json --include=src/app/html-security-audit.spec.ts",
    "deps:install": "npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund && node scripts/harden-dependencies.cjs && npm run deps:identity",
    "deps:harden": "node scripts/harden-dependencies.cjs",
    "cap": "node scripts/capacitor.cjs",
    "test:dependency-hardening": "node --test scripts/dependency-hardening.test.cjs",
    "deps:identity": "npm ci --prefix identity-runtime --ignore-scripts --no-audit --no-fund && node scripts/verify-identity-runtime.cjs",
    "test:identity:integration": "node scripts/verify-identity-runtime.cjs && node scripts/identity-protocol.test.cjs",
    "test:identity:browser": "node scripts/identity-browser.test.cjs",
    "build:design-runtime": "node scripts/build-design-runtime.cjs",
    "test:upgrade-storage": "node --test scripts/notes-database-upgrade.test.cjs",
    "build:design-app": "node scripts/stage-design-assets.cjs",
    "test:build-tool-hardening": "node scripts/harden-dependencies.cjs && STELLAR_REVIEWED_BUILD_TOOLS=1 node --test scripts/build-tool-hardening.test.cjs",
    "test:release": "node scripts/test-release.cjs",
    "test:mobile": "node scripts/test-release.cjs --mobile-only"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.26",
